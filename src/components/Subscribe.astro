---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";

type Props = HTMLAttributes<"section">;

const { class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);

// Tokenized subscription-form endpoint for this blog's follow.it feed.
// Regenerate from the follow.it dashboard if the feed is ever recreated.
const FOLLOW_IT_ACTION =
  "https://api.follow.it/subscription-form/bDZld08rMlkydW1hVzNvaEU3eWx6UEZ0TTNJTmhJcjFic08vcUVyQmgybGZQenBWcFNYaHpZZGhEN2RCT0hyYnM5RGk0ZGxzckdodVlja1IzT0c5ZUg1R3R3amdGVmZaRytkVmxjRnlHd0xHdmxGNHd6UWFhdU5yZ04wZTdqZnF8NzZHTHQ1a0dQWE9SYkJqL0E5a1Z6bkowSVlNelM2bzR3S3hVcVZpd2JQMD0=/8";
---

<section
  aria-labelledby="subscribe-heading"
  class:list={["border-border border-t py-6", className]}
  {...attrs}
>
  <h2 id="subscribe-heading" class="text-lg font-semibold">
    {t.subscribe.heading}
  </h2>
  <p class="text-muted-foreground mt-1 text-sm">{t.subscribe.description}</p>

  <form
    action={FOLLOW_IT_ACTION}
    method="post"
    target="_blank"
    data-astro-reload
    class="mt-3 flex flex-col gap-2 sm:flex-row"
  >
    <label class="sr-only" for="subscribe-email">{t.subscribe.emailLabel}</label
    >
    <input
      id="subscribe-email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder={t.subscribe.placeholder}
      class="border-border bg-background focus-visible:outline-accent w-full rounded-md border px-3 py-2 focus-visible:outline-2 focus-visible:outline-dashed sm:flex-1"
    />
    <button
      type="submit"
      class="bg-foreground text-background rounded-md px-4 py-2 font-semibold whitespace-nowrap hover:opacity-90"
    >
      {t.subscribe.button}
    </button>
  </form>
</section>
